      "steps": [
        {
          "id": "brief",
          "kind": "response",
          "title": "提炼卖点",
          "prompt": "根据商品信息为电商套图提炼核心卖点、目标受众、平台表达重点和文案关键词，只返回结果就好，不要其他多余信息。平台：{{field \"platform\"}}。文案语言：{{field \"copy_language\"}}。受众目标：{{field \"audience\"}}。商品信息：\n{{field \"product_brief\"}}\n{{with field \"visual_style\"}}视觉风格：{{.}}\n{{end}}"
        },
        {
          "id": "white_bg_main",
          "kind": "image",
          "template_type": "main",
          "title": "主图 · 产品白底图",
          "prompt": "生成电商主图：产品白底图。画面比例 1:1，产品居中，占画面主体，背景纯净，边缘清晰，适合{{field \"platform\"}}商品主图。文案语言：{{field \"copy_language\"}}。受众：{{field \"audience\"}}。商品信息：\n{{field \"product_brief\"}}\n卖点提炼：\n{{stepText \"brief\"}}\n{{with field \"visual_style\"}}视觉风格：{{.}}\n{{end}}",
          "count": "1",
          "size": "{{commerceSize (field \"image_resolution\") \"main\"}}",
          "use_references": true,
          "example": "imgs/workflow-main-white-bg.jpg"
        },
        {
          "id": "hero_main",
          "kind": "image",
          "template_type": "main",
          "title": "主图 · 首屏主视觉",
