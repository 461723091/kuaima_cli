          "count": "1",
          "size": "{{commerceSize (field \"image_resolution\") \"main\"}}",
          "use_references": true,
          "example": "imgs/workflow-main-hero.jpg"
        },
        {
          "id": "scene_main",
          "kind": "image",
          "template_type": "main",
